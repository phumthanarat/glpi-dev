# Settings for ./install.sh — copy to install.env, fill in, keep it OUT of git
# (install.env is in .gitignore: it holds passwords).
#
#   cp install.env.example install.env && vi install.env && ./install.sh -c install.env

# --- Kubernetes -------------------------------------------------------------
NAMESPACE=glpi
# Kustomize overlay to deploy (k8s/overlays/production: Longhorn RWX volume + Kong Ingress)
OVERLAY=k8s/overlays/production
# GLPI image built from this repo's Dockerfile and pushed to a registry every node can pull
# from, e.g.  docker build -t ghcr.io/<you>/glpi-itsm:11.0 . && docker push ghcr.io/<you>/glpi-itsm:11.0
IMAGE=ghcr.io/CHANGEME/glpi-itsm:11.0

# --- Address users open GLPI with (Ingress host is taken from it) ------------
GLPI_URL=https://itsm.company.com

# --- Database: MySQL 8.0+ / MariaDB 10.6+, utf8mb4, an empty database + a user with all
#     rights on it. MariaDB 11.6+: set innodb_snapshot_isolation=OFF (k8s/INSTALL-production.md)
DB_HOST=CHANGEME
DB_PORT=3306
DB_NAME=glpi
DB_USER=glpi
DB_PASSWORD=CHANGEME
# Language of the new database (en_GB, th_TH, ...)
GLPI_LANGUAGE=en_GB

# --- New password of the 'glpi' Super-Admin (12+ characters). tech / normal / post-only
#     (public default passwords) are deactivated; KEEP_DEFAULT_ACCOUNTS=1 keeps them.
GLPI_ADMIN_PASSWORD=CHANGEME
KEEP_DEFAULT_ACCOUNTS=0

# --- Outgoing mail (notifications). Port 587 = STARTTLS, 465 = TLS.
SMTP_HOST=smtp.company.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_VERIFY_CERT=1
MAIL_FROM=itsm@company.com
MAIL_FROM_NAME=IT Service Desk

# --- Optional: e-mail ticket channel (IT mailbox read over IMAP). Leave MAIL_INTAKE_HOST
#     empty to skip. Format: {host:993/imap/ssl}INBOX
MAIL_INTAKE_HOST=
MAIL_INTAKE_ADDRESS=it-support@company.com
MAIL_INTAKE_LOGIN=
MAIL_INTAKE_PASSWORD=
